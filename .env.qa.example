# QA env (salin ke .env.qa.local, jangan di-commit)
QA_ENV=prod                         # local | staging | prod
QA_BASE_URL=https://puput-lpg.vercel.app
QA_PROD_HOSTS=puput-lpg.vercel.app
QA_ALLOW_WRITES=0                   # 1 hanya untuk local/staging
QA_OWNER_EMAIL=
QA_OWNER_PASSWORD=
QA_STAFF_EMAIL=
QA_STAFF_PASSWORD=
QA_SUPABASE_URL=
QA_SUPABASE_ANON_KEY=
QA_SUPABASE_SERVICE_ROLE_KEY=       # HANYA local/staging
QA_DB_URL=                          # opsional, koneksi Postgres langsung (local/staging)
QA_CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
