# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Security Secret untuk Token Override Tempo (Minimal 32 karakter acak, SERVER-ONLY)
JWT_SECRET=ganti_dengan_minimal_32_karakter_acak

# Password Seed Awal (Hanya dipakai saat menjalankan npm run seed:users secara lokal)
SEED_OWNER_PASSWORD=OwnerLpg123!
SEED_STAFF_PASSWORD=StaffLpg123!

# Next.js & Metadata Pangkalan
NEXT_PUBLIC_APP_URL=https://nama-domain-vercel-anda.vercel.app
NEXT_PUBLIC_BUSINESS_NAME=Pangkalan LPG Sumber Rejeki
NEXT_PUBLIC_BUSINESS_ADDRESS=Jl. Kalimantan No. 45
NEXT_PUBLIC_BUSINESS_PHONE=081234567890
